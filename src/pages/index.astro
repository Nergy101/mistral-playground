<script>
  // ---------- shared state ----------
  const $ = (id: string) => document.getElementById(id)!;
  const state = {
    tab: 'voice',
    transcript: '',
    voiceAct: 'summary',
    visionMode: 'extract',
    preset: 'image',
    imageFile: null as File | null,
    jsonMode: false,
    visionRan: false,
    debug: {} as Record<string, any>,
  };

  // ---------- hero squares (positions from the design's sqDefs) ----------
  const sqDefs: [number, number, number, string, number, number, number, number][] = [
    [-2, 62, 120, '#FFC93C', 40, -60, 7, 0],
    [12, -8, 90, '#E1330B', 60, 50, 9, 1.2],
    [30, 78, 70, '#FFA234', -50, -40, 6, 0.6],
    [46, 4, 110, '#FA520F', 40, 60, 10, 2],
    [58, 70, 60, '#FFC93C', 60, -50, 8, 0.3],
    [70, -14, 140, '#FFA234', -40, 70, 11, 1.6],
    [86, 52, 100, '#E1330B', -60, -40, 9, 0.9],
    [94, 8, 70, '#FFC93C', -50, 50, 7, 2.4],
    [38, 40, 50, '#FFB07A', 50, -60, 8, 1.1],
  ];
  $('heroSquares').innerHTML = sqDefs.map(([l, t, size, c, dx, dy, d, delay]) =>
    `<div class="hero-sq" style="left:${l}%;top:${t}%;width:${size}px;height:${size}px;background:${c};--dx:${dx}px;--dy:${dy}px;animation-duration:${d}s;animation-delay:-${delay}s"></div>`
  ).join('');

  // ---------- lasagna easter egg ----------
  const LASAGNA = [
    { btn: 'Get Garfielded', say: 'Garfield says: feed me lasagna or perish.' },
    { btn: 'Love Lasagna', say: 'Lasagna is just a hug you can eat.' },
    { btn: 'Never enough lasagna', say: 'There is no such thing as too much lasagna.' },
    { btn: 'Lasagna over Mondays', say: "I don't hate Mondays. I hate empty plates." },
    { btn: 'Layer up', say: 'Every layer is a promise of more lasagna.' },
    { btn: 'Mondays are the enemy', say: 'A Monday is just a lasagna with the cheese pulled out.' },
    { btn: 'I work out', say: 'I do not exercise. I just eat lasagna faster.' },
    { btn: 'Diet starts tomorrow', say: 'My diet starts tomorrow. Today is lasagna.' },
    { btn: 'Lasagna is my cardio', say: 'Cardio? I prefer lasagna-o.' },
    { btn: 'Lasagna is the answer', say: 'Lasagna is the answer. What was the question?' },
    { btn: 'Get in my belly', say: 'Get in my belly! — every cat, probably.' },
    { btn: 'Cheese pull ASMR', say: 'The cheese pull is the sound of happiness.' },
    { btn: 'A lasagna a day', say: 'A lasagna a day keeps the Mondays away.' },
    { btn: 'Lasagna is a lifestyle', say: 'I do not eat lasagna. Lasagna eats me. Happily.' },
    { btn: 'I ate 40 lasagnas', say: 'I once ate 40 lasagnas. It was a good day.' },
    { btn: 'Hate empty ovens', say: 'I hate Mondays. And empty ovens.' },
  ];
  let lastLasagna = -1;
  $('lasagnaBtn').addEventListener('click', () => {
    let i: number;
    do { i = Math.floor(Math.random() * LASAGNA.length); } while (i === lastLasagna);
    lastLasagna = i;
    $('lasagnaBtn').textContent = LASAGNA[i].btn;
    $('catBubble').textContent = LASAGNA[i].say;
  });

  // ---------- waveform: 5 loader blocks (grayed out until recording starts) ----------
  $('wave').innerHTML = '<span></span>'.repeat(5);

  // ---------- tabs ----------
  const catLines: Record<string, string> = {
    voice: "I'm all ears. Literally, they're huge.",
    vision: 'Show me the thing. I will judge it.',
    tools: 'I know a guy. The guy is a function.',
  };
  const catOverlays: Record<string, string> = {
    voice: '/assets/overlay-voxtral-headphones.svg',
    vision: '/assets/overlay-multimodal-big-eyes.svg',
    tools: '/assets/overlay-tools-gradcap.svg',
  };
  const TABS = ['voice', 'vision', 'tools'];
  function activateTab(tab: string, updateHash = false) {
    if (!TABS.includes(tab)) tab = 'voice';
    state.tab = tab;
    document.querySelectorAll('.tab').forEach((b) => {
      const on = (b as HTMLElement).dataset.tab === tab;
      b.classList.toggle('active', on);
      b.setAttribute('aria-selected', String(on));
    });
    $('panel-voice').style.display = tab === 'voice' ? 'flex' : 'none';
    $('panel-vision').style.display = tab === 'vision' ? 'flex' : 'none';
    $('panel-tools').style.display = tab === 'tools' ? 'flex' : 'none';
    $('catBubble').textContent = catLines[tab];
    $('catOverlay').setAttribute('src', catOverlays[tab]);
    if (updateHash) history.replaceState(null, '', '#' + tab);
    renderHood();
  }
  document.querySelectorAll('.tab').forEach((btn) => {
    btn.addEventListener('click', () => activateTab((btn as HTMLElement).dataset.tab!, true));
  });
  // remember the open tab in the URL hash: refresh / shared link / back-forward
  window.addEventListener('hashchange', () => activateTab(location.hash.replace('#', '')));
  activateTab(location.hash.replace('#', ''));

  // ---------- under the hood ----------
  function sanitize(v: any): any {
    if (typeof v === 'string' && v.length > 300) return v.slice(0, 120) + `… [${v.length} chars]`;
    if (Array.isArray(v)) return v.map(sanitize);
    if (v && typeof v === 'object') {
      return Object.fromEntries(Object.entries(v).map(([k, x]) => [k, k === 'image_url' ? { image_url: { url: '[base64 image data]' } } : sanitize(x)]));
    }
    return v;
  }
  function renderHood() {
    const d = state.debug[state.tab];
    if (!d) { $('hoodReq').textContent = '(run a demo first)'; $('hoodRes').textContent = ''; $('hoodMeta').textContent = 'tokens — · latency — · ' + ($('hoodBody').style.display === 'none' ? 'show' : 'hide'); return; }
    $('hoodReq').textContent = JSON.stringify(sanitize(d.request), null, 2);
    $('hoodRes').textContent = JSON.stringify(sanitize(d.response), null, 2);
    const u = d.usage;
    const tokens = u ? (u.prompt_tokens ?? 0) + (u.completion_tokens ?? 0) : null;
    $('hoodMeta').textContent = `tokens ${tokens ?? '—'} · latency ${d.latencyMs ?? '—'} ms · ` + ($('hoodBody').style.display === 'none' ? 'show' : 'hide');
  }
  $('hoodBtn').addEventListener('click', () => {
    const open = $('hoodBody').style.display === 'none';
    $('hoodBody').style.display = open ? 'grid' : 'none';
    $('hoodBtn').setAttribute('aria-expanded', String(open));
    renderHood();
  });

  // ---------- JSON syntax highlighting ----------
  function highlight(json: string): string {
    const esc = json.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    return esc.replace(/("(\\u[a-zA-Z0-9]{4}|\\[^u]|[^\\"])*")(\s*:)?|\b(true|false)\b|\b-?\d+(\.\d+)?\b/g, (m, str, _g, colon, bool) => {
      if (str) return colon ? `<span class="k">${str}</span>${colon}` : `<span class="s">${str}</span>`;
      if (bool) return `<span class="n">${m}</span>`;
      return `<span class="n">${m}</span>`;
    }).replace(/[{}]/g, '<span class="b">$&</span>');
  }

  // ---------- 01 VOXTRAL ----------
  // Realtime dictation, same treatment as the voxtral-demo: mic -> PCM16 16kHz
  // chunks -> /api/rt/audio -> SSE deltas rendered live (confirmed text +
  // dimmed partial tail + blinking caret). Uploaded files still use the batch
  // /api/transcribe path, where the result lands all at once.
  let rt: {
    session: string; es: EventSource; mic: { stop: () => void; analyser: AnalyserNode | null } | null;
    uploadCtrl: AbortController; text: string; recording: boolean;
    push: (chunk: Uint8Array) => void;
  } | null = null;
  let recStart = 0, recTimer: number | undefined, recSeconds = 0, waveRaf = 0, detectedLang = '';
  const fmt = (s: number) => `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`;
  const timerEl = () => $('timer');
  const transcriptEl = () => $('transcript') as HTMLDivElement;
  function setRecState(state: 'idle' | 'listening' | 'busy' | 'stopped') {
    const btn = $('recordBtn');
    const t = timerEl();
    btn.classList.toggle('recording', state === 'listening');
    btn.setAttribute('aria-label', state === 'listening' ? 'Stop recording' : 'Start recording');
    t.classList.toggle('listening', state === 'listening');
    t.classList.toggle('busy', state === 'busy');
    if (state === 'idle') t.textContent = 'idle · press the button to start listening';
    if (state === 'listening') t.textContent = `${fmt(Math.floor((Date.now() - recStart) / 1000))} · listening${detectedLang ? ` — detected: ${detectedLang}` : '…'}`;
    if (state === 'busy') t.textContent = `${fmt(recSeconds)} · stopped listening · transcribing…`;
    if (state === 'stopped') t.textContent = `${fmt(recSeconds)} · stopped listening · transcript ready`;
  }
  function setFinalTranscript(text: string) {
    const t = transcriptEl();
    t.innerHTML = '<span class="confirmed"></span>';
    t.querySelector('.confirmed')!.textContent = text ? `“${text}”` : '(no speech detected)';
  }
  // Live render: last ~30 chars dimmed as "partial", the rest confirmed.
  // Updates the existing spans in place — no innerHTML rebuild, no flicker.
  function renderLiveTranscript() {
    const t = transcriptEl();
    const full = rt?.text ?? '';
    const split = Math.max(0, full.length - 30);
    let c = t.querySelector('.confirmed');
    if (!c) {
      t.innerHTML = '<span class="confirmed"></span><span class="partial"></span><span class="cursor"></span>';
      c = t.querySelector('.confirmed')!;
    }
    c.textContent = full.slice(0, split);
    t.querySelector('.partial')!.textContent = full.slice(split);
  }

  // mic -> PCM s16le 16kHz mono chunks (same capture as the voxtral-demo)
  async function startMic(onChunk: (c: Uint8Array) => void) {
    const stream = await navigator.mediaDevices.getUserMedia({ audio: { channelCount: 1 } });
    const ctx = new AudioContext({ sampleRate: 16000 });
    await ctx.resume(); // ensure running (autoplay policy)
    const src = ctx.createMediaStreamSource(stream);
    // analyser taps the same source so the wave blocks can react to real levels
    const analyser = ctx.createAnalyser();
    analyser.fftSize = 64; // 32 frequency bins
    src.connect(analyser);
    const worklet = new Blob([`
      class Pcm extends AudioWorkletProcessor {
        process(inputs) {
          const ch = inputs[0]?.[0];
          if (ch) this.port.postMessage(ch.slice(0), [ch.buffer]);
          return true;
        }
      }
      registerProcessor('pcm', Pcm);
    `], { type: 'application/javascript' });
    await ctx.audioWorklet.addModule(URL.createObjectURL(worklet));
    const node = new AudioWorkletNode(ctx, 'pcm');
    node.port.onmessage = (e) => {
      const f = e.data as Float32Array, out = new Int16Array(f.length);
      for (let i = 0; i < f.length; i++) out[i] = Math.max(-1, Math.min(1, f[i])) * 0x7fff;
      onChunk(new Uint8Array(out.buffer));
    };
    src.connect(node);
    return { stop: () => { src.disconnect(); node.disconnect(); ctx.close(); stream.getTracks().forEach((t) => t.stop()); }, analyser };
  }

  async function startRealtime() {
    $('voiceErr').textContent = '';
    const lang = ($('langSelect') as HTMLSelectElement).value;
    const t = timerEl();
    t.classList.add('busy'); t.classList.remove('listening');
    t.textContent = 'connecting…';
    const res = await fetch(`/api/rt/start?language=${encodeURIComponent(lang)}`, { method: 'POST' });
    const boot = await res.json();
    if (!res.ok) throw new Error(boot.error || res.statusText);
    const session: string = boot.session;
    rt = { session, es: new EventSource(`/api/rt/events?session=${session}`), mic: null, uploadCtrl: new AbortController(), text: '', recording: true, push: () => {} };
    // live transcript skeleton: empty confirmed + "Listening…" partial + caret
    transcriptEl().innerHTML = '<span class="confirmed"></span><span class="partial">Listening…</span><span class="cursor"></span>';
    rt.es.addEventListener('delta', (e) => {
      if (!rt) return;
      rt.text += (JSON.parse(e.data) as { text: string }).text;
      renderLiveTranscript();
    });
    rt.es.addEventListener('language', (e) => {
      if (!rt) return;
      detectedLang = (JSON.parse(e.data) as { language: string }).language;
      setRecState('listening');
    });
    rt.es.addEventListener('done', (e) => {
      if (!rt) return;
      const { text, usage } = JSON.parse(e.data) as { text?: string; usage?: any };
      if (text) rt.text = text;
      finalizeRealtime(usage);
    });
    rt.es.addEventListener('interrupted', () => {
      if (!rt) return;
      const tEl = transcriptEl();
      tEl.querySelector('.cursor')?.remove();
      tEl.insertAdjacentHTML('beforeend', ' <span class="tag">[interrupted — partial kept]</span>');
      finalizeRealtime();
    });
    rt.es.addEventListener('error', (e) => {
      try { $('voiceErr').textContent = 'Realtime error: ' + JSON.parse(e.data).message; }
      catch { $('voiceErr').textContent = 'Realtime stream error'; }
    });
    // each PCM chunk is its own POST — reliable in all browsers
    rt.push = (chunk) => {
      fetch(`/api/rt/audio?session=${session}`, { method: 'POST', body: chunk, signal: rt!.uploadCtrl.signal })
        .catch((err) => { if (err.name !== 'AbortError') console.warn('audio upload', err); });
    };
    rt.mic = await startMic((chunk) => rt!.push(chunk));
    recStart = Date.now();
    detectedLang = '';
    $('wave').classList.add('live'); // blocks light up in color while listening
    setRecState('listening');
    recTimer = window.setInterval(() => setRecState('listening'), 200);
    // wave blocks jump with the mic level: 5 blocks mapped to low->high
    // frequency bands; silence = all zeros = straight line
    const freq = new Uint8Array(32);
    const bins = [1, 3, 6, 10, 15];
    const waveLoop = () => {
      if (!rt?.recording) return;
      const an = rt.mic?.analyser;
      if (an) {
        an.getByteFrequencyData(freq);
        const blocks = $('wave').children;
        for (let i = 0; i < blocks.length; i++) {
          const v = freq[bins[i]] / 255; // 0..1
          (blocks[i] as HTMLElement).style.transform = `translateY(${-Math.round(v * 26)}px)`;
        }
      }
      waveRaf = requestAnimationFrame(waveLoop);
    };
    waveRaf = requestAnimationFrame(waveLoop);
  }

  function stopWave() {
    clearInterval(recTimer);
    cancelAnimationFrame(waveRaf);
    recSeconds = Math.floor((Date.now() - recStart) / 1000);
    // back to a straight line, grayed out
    $('wave').classList.remove('live');
    const blocks = $('wave').children;
    for (let i = 0; i < blocks.length; i++) (blocks[i] as HTMLElement).style.transform = '';
  }

  async function stopRealtime() {
    if (!rt?.recording) return;
    stopWave();
    rt.uploadCtrl.abort();
    rt.mic?.stop();
    setRecState('busy');
    // graceful end: server sends input_audio.end, final 'done' arrives on SSE
    await fetch(`/api/rt/finish?session=${rt.session}`, { method: 'POST' }).catch(() => {});
    // fallback: if 'done' doesn't arrive within 5s, finalize with what we have
    setTimeout(() => { if (rt?.recording) finalizeRealtime(); }, 5000);
  }

  async function interruptRealtime() {
    if (!rt?.recording) return;
    stopWave();
    rt.uploadCtrl.abort();
    rt.mic?.stop();
    await fetch(`/api/rt/abort?session=${rt.session}`, { method: 'POST' }).catch(() => {});
    finalizeRealtime();
  }

  function finalizeRealtime(usage?: any) {
    if (!rt) return;
    const text = rt.text;
    rt.recording = false;
    rt.es.close();
    rt = null;
    state.transcript = text;
    setFinalTranscript(text);
    setRecState('stopped');
    state.debug.voice = {
      request: { endpoint: 'realtime websocket · voxtral-mini-transcribe-realtime-3', language: ($('langSelect') as HTMLSelectElement).value || 'auto' },
      response: { text },
      usage: usage ?? null,
      latencyMs: Date.now() - recStart,
    };
    renderHood();
    runVoiceAction();
  }

  $('recordBtn').addEventListener('click', async () => {
    if (rt?.recording) { stopRealtime(); return; }
    try {
      await startRealtime();
    } catch (e: any) {
      $('voiceErr').textContent = 'Microphone unavailable: ' + e.message;
      setRecState('idle');
    }
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && rt?.recording) interruptRealtime(); });

  $('audioInput').addEventListener('change', () => {
    const f = ($('audioInput') as HTMLInputElement).files?.[0];
    if (f) transcribe(f);
  });

  async function transcribe(file: File) {
    // batch path for uploaded files — no live animation, result lands all at once
    $('voiceErr').textContent = '';
    $('voiceLoader').style.display = 'flex';
    $('voiceOut').textContent = '';
    const t = timerEl();
    t.classList.add('busy');
    t.classList.remove('listening');
    t.textContent = 'transcribing uploaded audio…';
    try {
      const fd = new FormData();
      fd.append('audio', file);
      const lang = ($('langSelect') as HTMLSelectElement).value;
      if (lang) fd.append('language', lang);
      const res = await fetch('/api/transcribe', { method: 'POST', body: fd });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || res.statusText);
      state.transcript = data.text;
      state.debug.voice = data.debug;
      setFinalTranscript(data.text);
      const t2 = timerEl();
      t2.classList.remove('busy');
      t2.textContent = 'transcript ready · record again or upload';
      renderHood();
      runVoiceAction();
    } catch (e: any) {
      $('voiceErr').textContent = 'Error: ' + e.message;
      setRecState('idle');
    } finally {
      $('voiceLoader').style.display = 'none';
    }
  }

  const voiceSystems: Record<string, string> = {
    summary: 'Summarise the following transcript in 2-3 sentences. Transcript:',
    actions: 'Extract action items from the following transcript as a checklist with ☐ boxes. Transcript:',
  };
  $('translateLang').addEventListener('change', () => {
    if (state.voiceAct === 'translate') runVoiceAction();
  });
  document.querySelectorAll('#voicePills .pill').forEach((p) => {
    p.addEventListener('click', () => {
      state.voiceAct = (p as HTMLElement).dataset.act!;
      document.querySelectorAll('#voicePills .pill').forEach((x) => {
        const on = x === p;
        x.classList.toggle('on', on);
        x.setAttribute('aria-pressed', String(on));
      });
      // language dropdown only makes sense for the Translate action
      ($('translateLang') as HTMLElement).style.display = state.voiceAct === 'translate' ? '' : 'none';
      runVoiceAction();
    });
  });
  async function runVoiceAction() {
    if (!state.transcript) return;
    $('voiceLoader').style.display = 'flex';
    $('voiceOut').textContent = '';
    try {
      const lang = ($('translateLang') as HTMLSelectElement).selectedOptions[0]?.textContent?.trim() || 'Nederlands';
      const prompt = state.voiceAct === 'translate'
        ? `Translate the following transcript into ${lang}. Return only the translation, no commentary. Transcript:\n\n${state.transcript}`
        : voiceSystems[state.voiceAct] + '\n\n' + state.transcript;
      const res = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ prompt }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || res.statusText);
      state.debug.voice = data.debug;
      $('voiceOut').textContent = data.answer;
      renderHood();
    } catch (e: any) {
      $('voiceErr').textContent = 'Error: ' + e.message;
    } finally {
      $('voiceLoader').style.display = 'none';
    }
  }

  // ---------- 02 MULTIMODAL ----------
  const SAMPLES = [
    { src: '/samples/receipt.jpg', name: 'receipt.jpg', preset: 'receipt' },
    { src: '/samples/whiteboard.jpg', name: 'whiteboard.jpg', preset: 'whiteboard' },
    { src: '/samples/chart.jpg', name: 'chart.jpg', preset: 'chart' },
    { src: '/samples/lighthouse.jpg', name: 'lighthouse.jpg', preset: 'image' },
  ];
  const PRESET_SAMPLE: Record<string, number> = { receipt: 0, whiteboard: 1, chart: 2, image: 3 };
  let sampleIdx = 3;
  let previewUrl: string | null = null;
  let visionRunId = 0;

  // Reset the output area to its idle state and invalidate any in-flight run,
  // so a stale response can never overwrite newer UI or leave the empty
  // schema skeleton hanging after an error.
  function resetVisionOutput() {
    visionRunId++;
    $('visionErr').textContent = '';
    $('visionLoader').style.display = 'none';
    ($('analyzeBtn') as HTMLButtonElement).disabled = false;
    $('visionText').style.display = 'none';
    $('schemaBadge').style.display = 'none';
    if (state.visionMode === 'extract') {
      $('visionOut').innerHTML = highlight(JSON.stringify(EMPTY_SCHEMAS[state.preset] ?? EMPTY_SCHEMAS.image, null, 2));
      $('visionOut').style.display = 'block';
    } else {
      $('visionOut').style.display = 'none';
    }
  }

  async function loadSample(i: number) {
    sampleIdx = ((i % SAMPLES.length) + SAMPLES.length) % SAMPLES.length;
    const s = SAMPLES[sampleIdx];
    const res = await fetch(s.src);
    const blob = await res.blob();
    state.imageFile = new File([blob], s.name, { type: 'image/jpeg' });
    setPreview(URL.createObjectURL(blob));
    document.querySelectorAll('.sample-thumb').forEach((b, bi) => b.classList.toggle('on', bi === sampleIdx));
    resetVisionOutput();
  }
  function setPreview(url: string) {
    if (previewUrl) URL.revokeObjectURL(previewUrl);
    previewUrl = url;
    ($('imgPreview') as HTMLImageElement).src = url;
  }
  document.querySelectorAll('.sample-thumb').forEach((b) => {
    b.addEventListener('click', (e) => {
      e.stopPropagation();
      loadSample(Number((b as HTMLElement).dataset.sample));
    });
  });
  $('sampleLink').addEventListener('click', (e) => { e.preventDefault(); e.stopPropagation(); loadSample(sampleIdx + 1); });
  $('dropzone').addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a,button')) return; // let links/thumbs handle their own clicks
    ($('imageInput') as HTMLInputElement).click();
  });
  $('dropzone').addEventListener('dragover', (e) => e.preventDefault());
  $('dropzone').addEventListener('drop', (e) => {
    e.preventDefault();
    const f = e.dataTransfer?.files?.[0];
    if (f) setImage(f);
  });
  $('imageInput').addEventListener('change', () => {
    const f = ($('imageInput') as HTMLInputElement).files?.[0];
    if (f) setImage(f);
  });
  function setImage(f: File) {
    state.imageFile = f;
    setPreview(URL.createObjectURL(f));
    document.querySelectorAll('.sample-thumb').forEach((b) => b.classList.remove('on'));
    resetVisionOutput();
  }

  // ---------- image lightbox ----------
  function openLightbox() {
    const src = ($('imgPreview') as HTMLImageElement).src;
    if (!src) return;
    $('lightboxImg').setAttribute('src', src);
    $('lightbox').classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeLightbox() {
    $('lightbox').classList.remove('open');
    document.body.style.overflow = '';
  }
  $('expandBtn').addEventListener('click', (e) => { e.stopPropagation(); openLightbox(); });
  $('lightboxClose').addEventListener('click', closeLightbox);
  $('lightbox').addEventListener('click', (e) => { if (e.target === $('lightbox')) closeLightbox(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeLightbox(); });
  document.querySelectorAll('#presetPills .pill').forEach((p) => {
    p.addEventListener('click', () => {
      state.preset = (p as HTMLElement).dataset.preset!;
      document.querySelectorAll('#presetPills .pill').forEach((x) => {
        const on = x === p;
        x.classList.toggle('on', on);
        x.setAttribute('aria-pressed', String(on));
      });
      // Presets only apply to Extract JSON — switch to it and load the
      // matching sample image (analysis starts when Analyze is pressed).
      if (state.visionMode !== 'extract') {
        state.visionMode = 'extract';
        document.querySelectorAll('#modeSeg button').forEach((x) => {
          const on = (x as HTMLElement).dataset.mode === 'extract';
          x.classList.toggle('on', on);
          x.setAttribute('aria-pressed', String(on));
        });
      }
      loadSample(PRESET_SAMPLE[state.preset] ?? 3);
    });
  });
  document.querySelectorAll('#modeSeg button').forEach((b) => {
    b.addEventListener('click', () => {
      state.visionMode = (b as HTMLElement).dataset.mode!;
      document.querySelectorAll('#modeSeg button').forEach((x) => {
        const on = x === b;
        x.classList.toggle('on', on);
        x.setAttribute('aria-pressed', String(on));
      });
      // no auto-run: reset the output area to the idle state for this mode
      resetVisionOutput();
    });
  });
  $('analyzeBtn').addEventListener('click', () => runVision());
  // Empty schema skeletons shown while the model is working (Extract JSON mode).
  const EMPTY_SCHEMAS: Record<string, object> = {
    receipt: { merchant: '', city: '', items: [], total: 0, currency: '' },
    whiteboard: { title: '', sections: [], action_items: [], people: [] },
    chart: { chart_type: '', title: '', x_axis: '', y_axis: '', series: [], takeaway: '' },
    image: { scene_type: '', setting: '', main_subjects: [], visible_text: [], colors: [], estimated_time_of_day: '' },
  };

  async function runVision() {
    if (!state.imageFile) { $('visionErr').textContent = 'Pick an image first (or try a sample).'; return; }
    const myRun = ++visionRunId;
    state.visionRan = true;
    $('visionErr').textContent = '';
    ($('analyzeBtn') as HTMLButtonElement).disabled = true;
    $('visionLoader').style.display = 'flex';
    $('visionText').style.display = 'none';
    $('schemaBadge').style.display = 'none';
    if (state.visionMode === 'extract') {
      // show the empty schema immediately; loader sits underneath
      $('visionOut').innerHTML = highlight(JSON.stringify(EMPTY_SCHEMAS[state.preset] ?? EMPTY_SCHEMAS.image, null, 2));
      $('visionOut').style.display = 'block';
    } else {
      $('visionOut').style.display = 'none';
    }
    try {
      const fd = new FormData();
      fd.append('image', state.imageFile);
      fd.append('mode', state.visionMode);
      fd.append('preset', state.preset);
      const res = await fetch('/api/vision', { method: 'POST', body: fd });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || res.statusText);
      if (myRun !== visionRunId) return; // a newer run or reset superseded this one
      state.debug.vision = data.debug;
      if (data.mode === 'describe') {
        $('visionText').textContent = data.description;
        $('visionText').style.display = 'block';
      } else {
        const rawOut: string = data.extractionRaw ?? (data.extraction != null ? JSON.stringify(data.extraction, null, 2) : '');
        $('visionOut').innerHTML = rawOut.trim() ? highlight(rawOut) : '<span class="n">(model returned an empty response)</span>';
        $('visionOut').style.display = 'block';
        if (data.extraction) $('schemaBadge').style.display = 'inline-flex';
      }
      renderHood();
    } catch (e: any) {
      if (myRun !== visionRunId) return;
      $('visionErr').textContent = 'Error: ' + e.message;
      // don't leave the empty skeleton hanging — surface the failure in the output area
      if (state.visionMode === 'extract') {
        $('visionOut').textContent = '// request failed — ' + e.message;
        $('visionOut').style.display = 'block';
      } else {
        $('visionText').textContent = 'Error: ' + e.message;
        $('visionText').style.display = 'block';
      }
    } finally {
      if (myRun === visionRunId) {
        $('visionLoader').style.display = 'none';
        ($('analyzeBtn') as HTMLButtonElement).disabled = false;
      }
    }
  }
  // load the default sample preview on startup (analysis starts via the Analyze button)
  loadSample(3);

  // ---------- 03 TOOLS & JSON ----------
  $('jsonSwitch').addEventListener('click', () => {
    state.jsonMode = !state.jsonMode;
    $('jsonSwitch').classList.toggle('on', state.jsonMode);
    $('jsonSwitch').setAttribute('aria-checked', String(state.jsonMode));
  });
  $('clearChat').addEventListener('click', () => {
    $('chatLog').innerHTML = '';
    $('toolsErr').textContent = '';
  });
  async function sendTools() {
    const input = $('toolsInput') as HTMLInputElement;
    const prompt = input.value.trim();
    if (!prompt) return;
    input.value = '';
    $('toolsErr').textContent = '';
    const log = $('chatLog');
    log.insertAdjacentHTML('beforeend', `<div class="chat-user"></div>`);
    log.lastElementChild!.textContent = prompt;
    $('toolsLoader').style.display = 'flex';
    try {
      const tools = Array.from(document.querySelectorAll('.toolChk:checked')).map((c) => (c as HTMLInputElement).value);
      const res = await fetch('/api/tools', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ prompt, tools, jsonMode: state.jsonMode }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || res.statusText);
      state.debug.tools = data.debug;
      for (const tc of data.toolCalls ?? []) {
        log.insertAdjacentHTML('beforeend',
          `<div class="chat-card"><span style="display:flex;align-items:center;gap:8px"><span class="tag" style="background:var(--accent)">tool_call</span><span class="mono">${tc.function.name}</span></span><code style="color:#FFB07A">${tc.function.arguments.replace(/</g, '&lt;')}</code></div>`);
      }
      for (const ex of data.executed ?? []) {
        log.insertAdjacentHTML('beforeend',
          `<div class="chat-card"><span style="display:flex;align-items:center;gap:8px"><span class="badge">result</span><span class="meta" title="The tool call is real, but this result is simulated server-side — the demo has no live weather or product backend.">mock result · simulated server-side</span></span><code style="color:#F2E3CF">${JSON.stringify(ex.result).replace(/</g, '&lt;')}</code></div>`);
      }
      if (state.jsonMode && data.answerRaw) {
        log.insertAdjacentHTML('beforeend', `<pre class="out">${highlight(data.answerRaw)}</pre>`);
      } else {
        log.insertAdjacentHTML('beforeend', `<div class="chat-assistant"></div>`);
        log.lastElementChild!.textContent = data.answer;
      }
      renderHood();
    } catch (e: any) {
      $('toolsErr').textContent = 'Error: ' + e.message;
    } finally {
      $('toolsLoader').style.display = 'none';
    }
  }
  $('toolsSend').addEventListener('click', sendTools);
  $('toolsInput').addEventListener('keydown', (e) => { if (e.key === 'Enter') sendTools(); });

  // ---------- 03b voice input for tools (voice -> skills) ----------
  // Same realtime pipeline as the Voxtral tab: mic -> PCM chunks -> SSE deltas,
  // rendered live with confirmed/partial/cursor. On stop, the transcript is
  // dropped into the message box and sent — so voice drives tool calling.
  let toolsRt: {
    session: string; es: EventSource; mic: { stop: () => void; analyser: AnalyserNode | null } | null;
    uploadCtrl: AbortController; text: string; recording: boolean;
    push: (chunk: Uint8Array) => void;
  } | null = null;

  function renderToolsLive() {
    const el = $('toolsLive');
    const full = toolsRt?.text ?? '';
    const split = Math.max(0, full.length - 30);
    let c = el.querySelector('.confirmed');
    if (!c) {
      el.innerHTML = '<span class="confirmed"></span><span class="partial"></span><span class="cursor"></span>';
      c = el.querySelector('.confirmed')!;
    }
    c.textContent = full.slice(0, split);
    el.querySelector('.partial')!.textContent = full.slice(split);
  }

  async function toolsMicStart() {
    $('toolsErr').textContent = '';
    const live = $('toolsLive');
    live.style.display = 'block';
    live.innerHTML = '<span class="confirmed"></span><span class="partial">Listening…</span><span class="cursor"></span>';
    // reuse the language picked in the Voxtral tab — everything is linked
    const lang = ($('langSelect') as HTMLSelectElement).value;
    const res = await fetch(`/api/rt/start?language=${encodeURIComponent(lang)}`, { method: 'POST' });
    const boot = await res.json();
    if (!res.ok) throw new Error(boot.error || res.statusText);
    const session: string = boot.session;
    toolsRt = { session, es: new EventSource(`/api/rt/events?session=${session}`), mic: null, uploadCtrl: new AbortController(), text: '', recording: true, push: () => {} };
    $('toolsMicBtn').classList.add('recording');
    toolsRt.es.addEventListener('delta', (e) => {
      if (!toolsRt) return;
      toolsRt.text += (JSON.parse(e.data) as { text: string }).text;
      renderToolsLive();
    });
    toolsRt.es.addEventListener('done', (e) => {
      if (!toolsRt) return;
      const { text } = JSON.parse(e.data) as { text?: string };
      if (text) toolsRt.text = text;
      toolsMicFinalize();
    });
    toolsRt.es.addEventListener('interrupted', () => { if (toolsRt) toolsMicFinalize(); });
    toolsRt.es.addEventListener('error', (e) => {
      try { $('toolsErr').textContent = 'Realtime error: ' + JSON.parse(e.data).message; }
      catch { $('toolsErr').textContent = 'Realtime stream error'; }
    });
    toolsRt.push = (chunk) => {
      fetch(`/api/rt/audio?session=${session}`, { method: 'POST', body: chunk, signal: toolsRt!.uploadCtrl.signal })
        .catch((err) => { if (err.name !== 'AbortError') console.warn('audio upload', err); });
    };
    toolsRt.mic = await startMic((chunk) => toolsRt!.push(chunk));
  }

  function toolsMicFinalize() {
    if (!toolsRt) return;
    const text = toolsRt.text.trim();
    toolsRt.recording = false;
    toolsRt.es.close();
    toolsRt = null;
    $('toolsMicBtn').classList.remove('recording');
    const live = $('toolsLive');
    if (text) {
      live.innerHTML = '<span class="confirmed"></span>';
      live.querySelector('.confirmed')!.textContent = `“${text}”`;
      ($('toolsInput') as HTMLInputElement).value = text;
      sendTools(); // voice -> skills: the transcript becomes the tool-calling prompt
    } else {
      live.innerHTML = '<span class="partial">(no speech detected — try again)</span>';
    }
  }

  async function toolsMicStop() {
    if (!toolsRt?.recording) return;
    toolsRt.uploadCtrl.abort();
    toolsRt.mic?.stop();
    await fetch(`/api/rt/finish?session=${toolsRt.session}`, { method: 'POST' }).catch(() => {});
    // fallback: if 'done' doesn't arrive within 5s, finalize with what we have
    setTimeout(() => { if (toolsRt?.recording) toolsMicFinalize(); }, 5000);
  }

  $('toolsMicBtn').addEventListener('click', async () => {
    if (toolsRt?.recording) { toolsMicStop(); return; }
    try {
      await toolsMicStart();
    } catch (e: any) {
      $('toolsErr').textContent = 'Microphone unavailable: ' + e.message;
      $('toolsMicBtn').classList.remove('recording');
      toolsRt = null;
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || !toolsRt?.recording) return;
    toolsRt.uploadCtrl.abort();
    toolsRt.mic?.stop();
    fetch(`/api/rt/abort?session=${toolsRt.session}`, { method: 'POST' }).catch(() => {});
    toolsMicFinalize();
  });
</script>
</body>
</html>
