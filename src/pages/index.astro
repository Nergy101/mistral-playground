---
// Le Chonk playground — main page. Design per handover: chonky dark theme,
// pixel cat, three demo tabs, under-the-hood drawer. All API calls proxied
// server-side via /api/*.
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>mistral.nergy.space — Meet Le Chonk</title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
<style>
  :root {
    --bg:#14100C; --surface:#1F1812; --surface-2:#2A2017; --code:#0E0A07; --code-2:#1A130D;
    --line:#4D3B2A; --line-soft:#6B5540; --text:#FFF3E3; --text-2:#E8D6BF; --muted:#CDB9A0;
    --ink:#1A1208; --accent:#FF8A2A; --yellow:#FFC93C; --btn:#FA520F; --ok:#B8F2C8; --ok-ink:#0E3B1C;
  }
  * { box-sizing: border-box; }
  body { margin:0; background:var(--bg); color:var(--text); font-family:'Bricolage Grotesque',system-ui,sans-serif; }
  a { color:var(--yellow); } a:hover { color:#FFE08A; }
  .wrap { max-width:1240px; margin:0 auto; padding:32px 24px 64px; display:flex; flex-direction:column; gap:28px; }
  .mono { font-family:'JetBrains Mono',monospace; }

  /* header */
  header { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:16px; }
  .brand { display:flex; align-items:center; gap:12px; text-decoration:none; color:var(--text); font-weight:800; font-size:20px; letter-spacing:-0.02em; }
  .brand .nergy { color:var(--accent); }
  nav { display:flex; flex-wrap:wrap; gap:10px; align-items:center; }
  .model-pill { font-family:'JetBrains Mono',monospace; font-size:13px; padding:8px 12px; border:2px solid var(--line); border-radius:999px; background:var(--surface); color:var(--text-2); }
  .docs-btn { font-weight:600; font-size:15px; padding:10px 16px; border:2px solid #000; border-radius:12px; background:var(--yellow); color:var(--ink); text-decoration:none; box-shadow:3px 3px 0 #000; }

  /* hero */
  .hero { display:flex; flex-wrap:wrap; align-items:flex-end; gap:24px 40px; padding:40px; border:3px solid #000; border-radius:28px; background:var(--accent); color:var(--ink); box-shadow:8px 8px 0 #000; position:relative; overflow:hidden; }
  .hero-sqs { position:absolute; inset:0; pointer-events:none; }
  :global(.hero-sq) { position:absolute; animation:hero-drift steps(8,end) infinite alternate; }
  @keyframes hero-drift { 0%{transform:translate(0,0);opacity:.85} 50%{opacity:.45} 100%{transform:translate(var(--dx),var(--dy));opacity:.9} }
  .hero-copy { flex:999 1 520px; min-width:0; display:flex; flex-direction:column; gap:16px; position:relative; z-index:1; }
  .chip { align-self:flex-start; font-family:'JetBrains Mono',monospace; font-size:13px; font-weight:600; padding:6px 10px; background:var(--bg); color:var(--text); border-radius:8px; }
  h1 { margin:0; font-size:clamp(48px,7vw,92px); line-height:.92; font-weight:800; letter-spacing:-0.04em; }
  .sub { margin:0; font-size:20px; line-height:1.4; max-width:560px; }
  .hero-cat { flex:1 1 280px; display:flex; justify-content:center; align-items:flex-end; position:relative; z-index:1; min-height:230px; }
  .bubble { position:absolute; top:-10px; left:-72px; max-width:220px; padding:12px 16px; background:var(--bg); color:var(--text); border:3px solid #000; border-radius:18px 18px 4px 18px; font-weight:600; font-size:17px; line-height:1.25; box-shadow:4px 4px 0 #000; }
  .cat-stack { position:relative; width:260px; height:190px; margin-top:70px; }
  .cat-stack img { position:absolute; left:0; top:0; image-rendering:pixelated; }

  /* tabs */
  .tabs { display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:14px; }
  .tab { display:flex; flex-direction:column; align-items:flex-start; gap:6px; text-align:left; padding:18px 20px; min-height:44px; cursor:pointer; font-family:inherit; border-radius:18px; transition:transform .12s, box-shadow .12s; background:var(--surface); color:var(--text); border:3px solid var(--line); box-shadow:2px 2px 0 #000; }
  .tab.active { background:var(--accent); color:var(--ink); border:3px solid #000; box-shadow:6px 6px 0 #000; transform:translate(-2px,-2px); }
  .tab-top { display:flex; align-items:center; gap:10px; font-size:22px; font-weight:800; letter-spacing:-0.02em; }
  .tab-num { font-family:'JetBrains Mono',monospace; font-size:13px; padding:3px 7px; border-radius:6px; background:var(--surface-2); color:var(--yellow); border:2px solid var(--line); }
  .tab.active .tab-num { background:var(--bg); color:var(--text); border-color:transparent; }
  .tab-sub { font-size:15px; font-weight:400; }
  .tab-model { margin-top:4px; font-family:'JetBrains Mono',monospace; font-size:12px; line-height:1.4; padding:4px 8px; border-radius:6px; overflow-wrap:anywhere; white-space:pre-line; background:var(--code); color:var(--text-2); border:1px solid var(--line); }
  .tab.active .tab-model { background:var(--bg); color:var(--yellow); border-color:transparent; }

  /* panels */
  .panel-row { display:flex; flex-wrap:wrap; gap:20px; }
  .panel { padding:24px; background:var(--surface); border:3px solid var(--line); border-radius:22px; box-shadow:5px 5px 0 #000; }
  .panel.dark { background:var(--code); border-color:var(--accent); }
  .panel h2 { margin:0; font-size:22px; font-weight:800; }
  .panel h3 { margin:0; font-size:18px; font-weight:800; }
  .col { display:flex; flex-direction:column; gap:16px; min-width:0; }
  .dropzone { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:10px; padding:24px; background:var(--surface-2); border:2px dashed var(--line-soft); border-radius:16px; cursor:pointer; text-align:center; }
  .dropzone img { max-width:100%; max-height:260px; border-radius:8px; }
  .btn { min-height:44px; padding:0 16px; font:600 15px 'Bricolage Grotesque',sans-serif; border:2px solid var(--line-soft); border-radius:12px; background:var(--surface-2); color:var(--text); cursor:pointer; }
  .btn.primary { border:2px solid #000; background:var(--btn); color:var(--ink); font-weight:800; box-shadow:3px 3px 0 #000; }
  .btn.yellow { border:2px solid #000; background:var(--yellow); color:var(--ink); font-weight:800; box-shadow:3px 3px 0 #000; }
  .btn:disabled { opacity:.5; cursor:wait; }
  .pill { min-height:44px; padding:0 14px; font:600 14px 'Bricolage Grotesque',sans-serif; border-radius:999px; cursor:pointer; border:2px solid var(--line-soft); background:transparent; color:var(--text); }
  .pill.on { border-color:var(--accent); background:var(--accent); color:var(--ink); }
  .seg { display:flex; padding:4px; gap:4px; background:var(--surface-2); border-radius:12px; }
  .seg button { min-height:44px; padding:0 16px; border:none; border-radius:9px; cursor:pointer; font:600 15px 'Bricolage Grotesque',sans-serif; background:transparent; color:var(--text); }
  .seg button.on { background:var(--accent); color:var(--ink); }
  .badge { display:inline-flex; align-items:center; gap:6px; font-family:'JetBrains Mono',monospace; font-size:13px; padding:6px 10px; background:var(--ok); color:var(--ok-ink); border-radius:8px; font-weight:600; }
  .tag { font-family:'JetBrains Mono',monospace; font-size:12px; padding:4px 8px; background:var(--yellow); color:var(--ink); border-radius:6px; font-weight:600; }
  pre.out { margin:0; padding:18px; background:var(--code-2); border-radius:14px; overflow-x:auto; font-family:'JetBrains Mono',monospace; font-size:15px; line-height:1.65; color:var(--text); white-space:pre-wrap; word-break:break-word; }
  :global(.k) { color:#FFB07A; } :global(.s) { color:#B8F2C8; } :global(.n) { color:#8FD3FF; } :global(.b) { color:#FFC93C; }
  .loader-row { display:flex; align-items:center; gap:14px; padding:12px 0; }
  .chonk-loader { display:flex; align-items:flex-end; gap:4px; height:26px; }
  .chonk-loader span { display:block; width:14px; height:14px; animation:chonk-hop .9s ease-in-out infinite; }
  .chonk-loader span:nth-child(1){background:#FFC93C}
  .chonk-loader span:nth-child(2){background:#FFA234;animation-delay:.1s}
  .chonk-loader span:nth-child(3){background:#FF8A2A;animation-delay:.2s}
  .chonk-loader span:nth-child(4){background:#FA520F;animation-delay:.3s}
  .chonk-loader span:nth-child(5){background:#E1330B;animation-delay:.4s}
  @keyframes chonk-hop { 0%,60%,100%{transform:translateY(0)} 30%{transform:translateY(-10px)} }
  .loader-copy { font-family:'JetBrains Mono',monospace; font-size:14px; color:var(--text-2); }
  .record-btn { width:96px; height:96px; border-radius:50%; border:3px solid #000; background:var(--btn); box-shadow:4px 4px 0 #000; cursor:pointer; display:flex; align-items:center; justify-content:center; }
  .record-btn .icon-stop { display:none; }
  .record-btn.recording { background:#E1330B; animation:rec-pulse 1.1s ease-in-out infinite; }
  .record-btn.recording .icon-mic { display:none; }
  .record-btn.recording .icon-stop { display:block; }
  .mic-btn { width:48px; height:48px; flex:none; border-radius:50%; border:3px solid #000; background:var(--btn); box-shadow:3px 3px 0 #000; cursor:pointer; display:flex; align-items:center; justify-content:center; }
  .mic-btn .icon-stop { display:none; }
  .mic-btn.recording { background:#E1330B; animation:rec-pulse 1.1s ease-in-out infinite; }
  .mic-btn.recording .icon-mic { display:none; }
  .mic-btn.recording .icon-stop { display:block; }
  @keyframes rec-pulse { 0%,100%{ box-shadow:4px 4px 0 #000, 0 0 0 0 rgba(225,51,11,.55);} 50%{ box-shadow:4px 4px 0 #000, 0 0 0 16px rgba(225,51,11,0);} }
  .rec-status.listening { color:#FF6B6B; font-weight:600; }
  .rec-status.busy { color:var(--yellow); }
  /* live transcript — same treatment as the voxtral-demo: confirmed text,
     dimmed "partial" tail while speaking, blinking caret */
  .live-transcript { white-space:pre-wrap; word-break:break-word; }
  .live-transcript .confirmed { color:#F2E3CF; }
  .live-transcript .partial { color:var(--muted); transition:color .3s ease; }
  .live-transcript .cursor { display:inline-block; width:9px; height:1.1em; background:var(--accent); vertical-align:-0.15em; margin-left:2px; border-radius:2px; animation:blink 1s step-end infinite; }
  .live-transcript .tag { color:var(--accent); font-family:'JetBrains Mono',monospace; font-size:13px; }
  @keyframes blink { 50% { opacity:0; } }
  /* mic soundwave: the 5 chonk-loader blocks. Grayed out when nothing is
     listening; colored + jumping (translateY per frequency band) while recording */
  .wave { display:flex; align-items:flex-end; gap:4px; height:44px; }
  .wave :global(span) { display:block; width:14px; height:14px; border-radius:3px; background:#5A4532; transition:transform .09s ease-out, background-color .25s ease; will-change:transform; }
  .wave.live :global(span:nth-child(1)) { background:#FFC93C; }
  .wave.live :global(span:nth-child(2)) { background:#FFA234; }
  .wave.live :global(span:nth-child(3)) { background:#FF8A2A; }
  .wave.live :global(span:nth-child(4)) { background:#FA520F; }
  .wave.live :global(span:nth-child(5)) { background:#E1330B; }
  select, input[type=text], textarea { min-height:44px; font:400 15px 'Bricolage Grotesque',sans-serif; border:2px solid var(--line-soft); border-radius:12px; padding:0 10px; background:var(--surface-2); color:var(--text); }
  input[type=text], textarea { width:100%; background:var(--code); }
  textarea { min-height:80px; padding:10px 12px; resize:vertical; }
  .tool-label { display:flex; align-items:center; gap:12px; padding:12px 14px; border:2px solid var(--line); border-radius:14px; background:var(--surface-2); cursor:pointer; }
  .tool-label input { width:22px; height:22px; accent-color:var(--btn); }
  .chat-user { align-self:flex-end; max-width:80%; padding:12px 16px; background:var(--yellow); color:var(--ink); border-radius:16px 16px 4px 16px; font-size:17px; }
  .chat-card { display:flex; flex-direction:column; gap:8px; padding:14px; background:var(--code); border:2px solid var(--line); border-radius:14px; font-family:'JetBrains Mono',monospace; font-size:14px; }
  .chat-assistant { align-self:flex-start; max-width:85%; padding:12px 16px; background:var(--surface-2); border:2px solid var(--line); border-radius:4px 16px 16px 16px; font-size:17px; line-height:1.5; white-space:pre-line; }
  .switch { position:relative; width:60px; height:34px; flex:none; border-radius:999px; border:3px solid #000; cursor:pointer; padding:0; background:var(--line); }
  .switch .knob { position:absolute; top:3px; left:3px; width:22px; height:22px; border-radius:50%; background:var(--text); transition:left .15s; }
  .switch.on { background:var(--accent); } .switch.on .knob { left:29px; background:var(--bg); }
  .err { color:#FF6B6B; font-size:14px; }
  .meta { font-size:14px; color:var(--muted); }
  .sample-strip { display:flex; flex-wrap:wrap; gap:8px; align-items:center; }
  .sample-thumb { width:64px; height:48px; object-fit:cover; border-radius:8px; border:2px solid var(--line-soft); cursor:pointer; padding:0; background:var(--surface-2); }
  .sample-thumb.on { border-color:var(--accent); box-shadow:3px 3px 0 #000; }
  .analyze-btn { width:100%; font:600 16px 'Bricolage Grotesque',sans-serif; padding:12px 18px; border:3px solid #000; border-radius:12px; background:var(--yellow); color:var(--ink); cursor:pointer; box-shadow:4px 4px 0 #000; }
  .analyze-btn:active { transform:translate(2px,2px); box-shadow:2px 2px 0 #000; }
  .analyze-btn:disabled { opacity:.6; cursor:wait; }
  .lasagna-btn { align-self:flex-start; font-family:'JetBrains Mono',monospace; font-size:13px; font-weight:600; padding:8px 14px; border:2px solid #000; border-radius:999px; background:var(--bg); color:var(--text); cursor:pointer; box-shadow:3px 3px 0 #000; }
  .lasagna-btn:active { transform:translate(2px,2px); box-shadow:1px 1px 0 #000; }
  .clear-btn { display:flex;align-items:center;justify-content:center;width:36px;height:36px;border:2px solid var(--line);border-radius:10px;background:var(--surface);cursor:pointer;color:var(--text-2); }
  .clear-btn:hover { border-color:var(--accent); color:var(--accent); }
  .preview-wrap { position:relative; align-self:center; max-width:100%; }
  .expand-btn { position:absolute; right:8px; bottom:8px; min-height:44px; padding:0 12px; display:flex; align-items:center; gap:6px; font:600 14px 'Bricolage Grotesque',sans-serif; border:2px solid #000; border-radius:10px; background:var(--yellow); color:var(--ink); box-shadow:3px 3px 0 #000; cursor:pointer; }
  .lightbox { position:fixed; inset:0; z-index:50; background:rgba(10,7,4,.92); display:none; align-items:center; justify-content:center; padding:32px; cursor:zoom-out; }
  .lightbox.open { display:flex; }
  .lightbox img { max-width:100%; max-height:100%; border:3px solid #000; border-radius:12px; box-shadow:8px 8px 0 #000; image-rendering:auto; cursor:default; }
  .lightbox .close-btn { position:absolute; top:20px; right:24px; min-height:44px; padding:0 16px; font:800 15px 'Bricolage Grotesque',sans-serif; border:2px solid #000; border-radius:12px; background:var(--btn); color:var(--ink); box-shadow:3px 3px 0 #000; cursor:pointer; }

  /* under the hood */
  .hood { border:3px solid var(--line); border-radius:22px; background:var(--surface); overflow:hidden; }
  .hood > button { width:100%; min-height:56px; display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:12px; padding:10px 22px; background:var(--surface); border:none; cursor:pointer; font:800 18px 'Bricolage Grotesque',sans-serif; color:var(--text); }
  .hood-meta { font-family:'JetBrains Mono',monospace; font-size:13px; font-weight:400; color:var(--muted); }
  .hood-body { display:grid; grid-template-columns:repeat(auto-fit,minmax(320px,1fr)); border-top:3px solid var(--line); }
  .hood-col { padding:18px 22px; min-width:0; }
  .hood-col.req { background:var(--code); } .hood-col.res { background:var(--code-2); }
  .hood-col .lbl { font-family:'JetBrains Mono',monospace; font-size:12px; color:var(--yellow); }
  .hood-col pre { margin:8px 0 0; overflow-x:auto; font-family:'JetBrains Mono',monospace; font-size:14px; line-height:1.6; white-space:pre; color:#F2E3CF; }

  footer { display:flex; flex-wrap:wrap; justify-content:space-between; gap:12px; align-items:center; font-size:15px; color:var(--muted); }
  .ramp { display:flex; gap:3px; } .ramp div { width:16px; height:16px; }

  @media (max-width: 640px) {
    .wrap { padding:20px 14px 48px; gap:20px; }
    header { gap:10px; }
    .model-pill { font-size:12px; padding:6px 10px; }
    .docs-btn { padding:8px 12px; font-size:14px; }
    .hero { padding:24px 20px; border-radius:20px; box-shadow:5px 5px 0 #000; gap:16px; }
    h1 { font-size:clamp(40px, 12vw, 56px); }
    .sub { font-size:17px; }
    .bubble { left:0; top:-8px; max-width:200px; font-size:15px; padding:10px 12px; }
    .hero-cat { min-height:190px; flex-basis:100%; }
    .cat-stack { transform:scale(.82); transform-origin:bottom center; margin-top:44px; }
    .tabs { grid-template-columns:1fr; }
    .tab { padding:14px 16px; }
    .panel-row { flex-direction:column; }
    .panel { padding:18px; border-radius:18px; }
    .dropzone { padding:16px; }
    .dropzone img { max-height:200px; }
    .record-btn { width:84px; height:84px; }
    .hood-body { grid-template-columns:1fr; }
    .hood > button { padding:10px 16px; font-size:16px; }
    .seg button { padding:0 12px; font-size:14px; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.hero-sq) { animation:none; }
    .chonk-loader span { animation:chonk-fade 1.2s ease-in-out infinite; }
    .record-btn.recording { animation:none; }
    .mic-btn.recording { animation:none; }
    .live-transcript .cursor { animation:none; }
    @keyframes chonk-fade { 0%,100%{opacity:1} 50%{opacity:.35} }
  }
</style>
</head>
<body>
<div class="wrap" id="top">

  <header>
    <a class="brand" href="#top">
      <img src="/assets/logo-mark.svg" width="40" height="21" alt="" aria-hidden="true" />
      <span>mistral<span class="nergy">.nergy</span>.space</span>
    </a>
    <nav>
      <span class="model-pill">Mistral Large 4 · Le Chonk</span>
      <a class="docs-btn" href="https://docs.mistral.ai" target="_blank" rel="noopener">Mistral docs</a>
    </nav>
  </header>

  <section class="hero" aria-label="Intro">
    <div class="hero-sqs" aria-hidden="true" id="heroSquares"></div>
    <div class="hero-copy">
      <span class="chip">1T params · 1 very large cat</span>
      <h1>Meet Le Chonk.</h1>
      <p class="sub">Demos of Mistral's latest models.</p>
      <button class="lasagna-btn" id="lasagnaBtn">Get Garfielded</button>
    </div>
    <div class="hero-cat">
      <div class="bubble" id="catBubble">I'm all ears. Literally, they're huge.</div>
      <div class="cat-stack">
        <img src="/assets/chonk-cat.svg" width="260" height="190" alt="A very chonky pixel-art orange cat" role="img" />
        <img id="catOverlay" src="/assets/overlay-voxtral-headphones.svg" width="260" height="190" alt="" aria-hidden="true" />
      </div>
    </div>
  </section>

  <div class="tabs" role="tablist" aria-label="Demos" id="tabs">
    <button class="tab active" role="tab" aria-selected="true" data-tab="voice">
      <span class="tab-top"><span class="tab-num">01</span>Voxtral</span>
      <span class="tab-sub">Speech in, transcript out, then Le Chonk acts on it</span>
      <span class="tab-model">voxtral-mini-transcribe-3
mistral-large-4</span>
    </button>
    <button class="tab" role="tab" aria-selected="false" data-tab="vision">
      <span class="tab-top"><span class="tab-num">02</span>Multimodal</span>
      <span class="tab-sub">Image to text, or image to typed JSON</span>
      <span class="tab-model">mistral-large-4</span>
    </button>
    <button class="tab" role="tab" aria-selected="false" data-tab="tools">
      <span class="tab-top"><span class="tab-num">03</span>Tools &amp; JSON</span>
      <span class="tab-sub">Function calling and strict JSON mode</span>
      <span class="tab-model">mistral-large-4</span>
    </button>
  </div>

  <!-- 01 VOXTRAL -->
  <section class="panel-row" id="panel-voice" aria-label="Voxtral demo">
    <div class="panel col" style="flex:1 1 340px">
      <h2>1 · Talk to it</h2>
      <div class="dropzone" id="recordZone">
        <button class="record-btn" id="recordBtn" aria-label="Start recording">
          <svg class="icon-mic" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#1A1208" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="2" width="6" height="12" rx="3"></rect><path d="M5 10a7 7 0 0 0 14 0M12 17v5M8 22h8"></path></svg>
          <svg class="icon-stop" width="30" height="30" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="5" width="14" height="14" rx="2" fill="#1A1208"></rect></svg>
        </button>
        <div class="wave" id="wave" aria-hidden="true"></div>
        <span class="mono rec-status" id="timer" style="font-size:14px;color:var(--text-2)">idle · press the button to start listening</span>
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:10px">
