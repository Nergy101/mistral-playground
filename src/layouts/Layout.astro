---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · mistral.nergy</title>
    <style>
      :root {
        --bg: #0d0b09;
        --panel: #171310;
        --border: #2c241d;
        --text: #f3ede6;
        --muted: #a89888;
        --accent: #ff7000;
        --accent-soft: #ffb37a;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
        line-height: 1.6;
      }
      a { color: var(--accent-soft); text-decoration: none; }
      a:hover { color: var(--accent); }
      nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 2rem;
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        background: rgba(13, 11, 9, 0.9);
        backdrop-filter: blur(8px);
      }
      nav .brand { font-weight: 700; font-size: 1.1rem; color: var(--text); }
      nav .brand span { color: var(--accent); }
      nav .links a { margin-left: 1.25rem; color: var(--muted); font-size: 0.95rem; }
      nav .links a:hover { color: var(--text); }
      main { max-width: 1000px; margin: 0 auto; padding: 2.5rem 2rem 4rem; }
      footer {
        border-top: 1px solid var(--border);
        padding: 1.5rem 2rem;
        text-align: center;
        color: var(--muted);
        font-size: 0.85rem;
      }
      h1 { font-size: 2.4rem; line-height: 1.15; margin: 0 0 0.75rem; }
      h2 { font-size: 1.4rem; margin: 2rem 0 0.75rem; }
      .lede { color: var(--muted); font-size: 1.1rem; max-width: 42rem; }
      .cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1.25rem;
        margin-top: 2.5rem;
      }
      .card {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        transition: border-color 0.15s ease, transform 0.15s ease;
      }
      .card:hover { border-color: var(--accent); transform: translateY(-2px); }
      .card .tag { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); }
      .card h3 { margin: 0; font-size: 1.15rem; }
      .card p { margin: 0; color: var(--muted); font-size: 0.95rem; flex: 1; }
      .card .go { font-weight: 600; font-size: 0.9rem; }
      .panel {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1.5rem;
        margin-top: 1.5rem;
      }
      button {
        background: var(--accent);
        color: #1a0e00;
        border: none;
        border-radius: 8px;
        padding: 0.6rem 1.2rem;
        font-size: 0.95rem;
        font-weight: 700;
        cursor: pointer;
      }
      button:disabled { opacity: 0.5; cursor: wait; }
      button.secondary { background: transparent; color: var(--accent-soft); border: 1px solid var(--accent); }
      input[type="file"] { color: var(--muted); }
      textarea {
        width: 100%;
        min-height: 90px;
        background: var(--bg);
        color: var(--text);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 0.75rem;
        font: inherit;
        resize: vertical;
      }
      pre {
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 1rem;
        overflow-x: auto;
        font-size: 0.85rem;
        white-space: pre-wrap;
        word-break: break-word;
      }
      img.preview { max-width: 100%; max-height: 320px; border-radius: 8px; border: 1px solid var(--border); margin-top: 1rem; }
      .row { display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap; margin-top: 1rem; }
      .status { color: var(--muted); font-size: 0.9rem; }
      .error { color: #ff6b6b; }
      .label { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin: 1.25rem 0 0.4rem; }
    </style>
  </head>
  <body>
    <nav>
      <a class="brand" href="/">mistral<span>.nergy</span></a>
      <div class="links">
        <a href="/demos/vision">Vision</a>
        <a href="/demos/tools">Function calling</a>
        <a href="/demos/voxtral">Voxtral audio</a>
      </div>
    </nav>
    <main><slot /></main>
    <footer>mistral.nergy — live demos of the Mistral API · API keys stay server-side</footer>
  </body>
</html>
